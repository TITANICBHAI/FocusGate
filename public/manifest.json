{
  "manifest_version": 3,
  "name": "FocusGate: Website Blocker & Focus Timer",
  "version": "1.0.1",
  "description": "Block distracting websites and keywords with a focus timer, schedules and daily limits. Your data stays in your browser.",
  "homepage_url": "https://github.com/TITANICBHAI/FocusGate",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "FocusGate: Website Blocker & Focus Timer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "declarativeNetRequest",
    "notifications",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle Focus Session"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.google.com/*",
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "incognito": "spanning",
  "minimum_chrome_version": "110"
}