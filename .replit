modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FocusGate Docs Preview"

[[workflows.workflow]]
name = "FocusGate Docs Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run docs:dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
