modules = ["nodejs-20", "web", "nix", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FocusGate Docs Preview"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FocusGate Extension Preview"

[[workflows.workflow]]
name = "FocusGate Docs Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run docs:dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "FocusGate GitHub Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run github:sync"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "FocusGate Extension Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
publicDir = "docs"
